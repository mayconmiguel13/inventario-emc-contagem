# Porta da aplicação
PORT=5000

# String de Conexão com o Banco de Dados MySQL na Nuvem (Ex: TiDB Cloud, Aiven, Railway)
# Formato: mysql://usuario:senha@host:porta/banco?sslaccept=strict
DATABASE_URL="mysql://root:sua_senha@localhost:3306/gestao_juridica"

# Segredos Criptográficos para JWT (Gere strings seguras para produção)
JWT_SECRET="seu_jwt_secret_super_seguro_producao"
JWT_REFRESH_SECRET="seu_jwt_refresh_secret_super_seguro_producao"

# URL do Frontend em Produção (Vercel) para liberação de CORS
FRONTEND_URL="https://seu-juridico.vercel.app"

# Ambiente
NODE_ENV=production
